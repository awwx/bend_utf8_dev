#!/usr/bin/env bash
# Validate untrusted proofs against the reviewed challenge with Lean v4.35.0.
# Requires elan, bubblewrap with working Linux namespaces, and a non-root user.
# Usage: ./check
set -veuo pipefail
cd "$(dirname "$0")"
if [ "$#" -ne 0 ]; then echo "usage: $0" >&2; exit 2; fi
if [ "$(id -u)" -eq 0 ]; then
  echo "Run this checker as a non-root user: comparator's sandbox must not run privileged." >&2
  exit 2
fi
TC=leanprover/lean4:v4.35.0
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# Start with only the spec and its checks. The sandbox hides the rest of the
# repository, so Utf8Check cannot import implementation modules. No cached builds
# are copied. Challenge, configuration, Lake metadata and toolchain are trusted.
command cp Utf8Laws.lean Utf8Challenge.lean Utf8Check.lean \
  lakefile.toml lake-manifest.json lean-toolchain spec-comparator.json "$WORK/"
echo "== Independent specification checks ($TC)"
elan run "$TC" lake -d "$WORK" comparator --config="$WORK/spec-comparator.json" --paranoid

# Use a second clean project for the implementation, avoiding reuse of artifacts
# created by the first untrusted build.
SOLUTION="$WORK/solution"
mkdir "$SOLUTION"
command cp Utf8Laws.lean Utf8Challenge.lean Utf8Check.lean Utf8Bits.lean \
  Utf8Ref.lean Utf8Table.lean Utf8Proofs.lean Utf8StepFacts.lean Utf8Eval.lean \
  Utf8Solution.lean lakefile.toml lake-manifest.json lean-toolchain comparator.json "$SOLUTION/"
echo "== Implementation correctness ($TC)"
elan run "$TC" lake -d "$SOLUTION" comparator --config="$SOLUTION/comparator.json" --paranoid
echo "ALL CHECKS PASSED"
