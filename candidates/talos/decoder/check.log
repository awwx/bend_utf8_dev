Utf8Wasm.done_runs : ∀ (mem : Wasm.Mem) (v out : UInt32),
  out.toNat + 4 ≤ mem.pages * 65536 →
    Utf8Boundary.Calls Utf8Wasm.decoderModule "decode_done" mem [v, out] fun ws final =>
      (v = 0 → ws = [out] ∧ final = Utf8Boundary.storeWith Utf8Wasm.decoderModule mem) ∧
        (v ≠ 0 → ws = [4 + out] ∧ final = Utf8Boundary.storeWith Utf8Wasm.decoderModule (mem.write32 out 65533))
