  mem.pages ≤ 65536 →
    Utf8Boundary.Calls Utf8Wasm.decoderModule "decode_start_state" mem [] fun ws final =>
      ∃ v, ws = [v] ∧ Utf8Wasm.Rel [] v ∧ final = Utf8Boundary.storeWith Utf8Wasm.decoderModule mem
