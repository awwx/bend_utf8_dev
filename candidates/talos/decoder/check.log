Utf8Wasm.buffer_runs : ∀ (mem : Wasm.Mem) (v inp len out : UInt32),
  mem.pages ≤ 65536 →
    inp.toNat + len.toNat ≤ out.toNat →
      out.toNat + 8 * len.toNat ≤ mem.pages * 65536 →
        Utf8Boundary.Calls Utf8Wasm.decoderModule "decode_buffer" mem [v, inp, len, out] fun ws final =>
          ws =
              [(Utf8Wasm.runM v out mem (Utf8Boundary.bytesAt mem inp.toNat len.toNat)).fst,
                (Utf8Wasm.runM v out mem (Utf8Boundary.bytesAt mem inp.toNat len.toNat)).snd.fst] ∧
            final =
              Utf8Boundary.storeWith Utf8Wasm.decoderModule
                (Utf8Wasm.runM v out mem (Utf8Boundary.bytesAt mem inp.toNat len.toNat)).snd.snd
