Utf8Wasm.loop_correct : ∀ (n : Nat) (w : Wasm.Store Unit) (s inp len out : UInt32),
  len.toNat = n →
    w.mem.pages ≤ 65536 →
      inp.toNat + n ≤ out.toNat →
        out.toNat + 8 * n ≤ w.mem.pages * 65536 →
          Utf8Wasm.Reach (Utf8Wasm.loopHead w s inp len out)
            {
              expr :=
                Wasm.SmallStep.Expr.done
                  [Wasm.Value.i32 (Utf8Wasm.runM s out w.mem (Utf8Boundary.bytesAt w.mem inp.toNat n)).snd.fst,
                    Wasm.Value.i32 (Utf8Wasm.runM s out w.mem (Utf8Boundary.bytesAt w.mem inp.toNat n)).fst],
              store :=
                { runtime := Utf8Wasm.rt0,
                  wasm :=
                    { globals := w.globals, globalIds := w.globalIds, functionIds := w.functionIds,
                      mem := (Utf8Wasm.runM s out w.mem (Utf8Boundary.bytesAt w.mem inp.toNat n)).snd.snd,
                      extraMems := w.extraMems, memoryCaps := w.memoryCaps, memoryIds := w.memoryIds,
                      dataSegments := w.dataSegments, tables := w.tables, tableIds := w.tableIds,
                      elementSegments := w.elementSegments, elementValues := w.elementValues, tagIds := w.tagIds,
                      exns := w.exns, gcHeap := w.gcHeap, host := w.host } } }
