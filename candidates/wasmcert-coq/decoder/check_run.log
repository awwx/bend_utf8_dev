fragment_deterministic_outcome
     : forall (hs : host.host_state) (s : datatypes.store_record)
         (f : datatypes.frame)
         (es : list datatypes.administrative_instruction)
         (hs' : host.host_state) (s' : datatypes.store_record)
         (f' : datatypes.frame) (vs : list datatypes.value),
       is_true (cfg_ok s es) ->
       opsem.reduce_trans (hs, s, f, es)
         (hs', s', f', operations.v_to_e_list vs) ->
       deterministic_outcome (hs, s, f, es)
         (hs', s', f', operations.v_to_e_list vs)
where
?hfc : [ |- datatypes.host_function_class]
?memory : [ |- memory.BlockUpdateMemory]
?ho : [ |- host.host]
deterministic_outcome =
fun (hfc : datatypes.host_function_class) (memory : memory.BlockUpdateMemory)
  (ho : host.host)
  (c
   D : host.host_state * datatypes.store_record * datatypes.frame *
       list datatypes.administrative_instruction) =>
(forall
   c' : host.host_state * datatypes.store_record * datatypes.frame *
        list datatypes.administrative_instruction,
 opsem.reduce_trans c c' -> opsem.reduce_trans c' D) /\
(forall
   run : nat ->
         host.host_state * datatypes.store_record * datatypes.frame *
         list datatypes.administrative_instruction,
 run 0 = c ->
 (forall n : nat, opsem.reduce_tuple (run n) (run (S n))) -> False) /\
(forall
   c' : host.host_state * datatypes.store_record * datatypes.frame *
        list datatypes.administrative_instruction,
 opsem.reduce_trans c c' ->
 (forall
    c'' : host.host_state * datatypes.store_record * datatypes.frame *
          list datatypes.administrative_instruction,
  ~ opsem.reduce_tuple c' c'') ->
 c' = D)
     : forall {hfc : datatypes.host_function_class}
         {memory : memory.BlockUpdateMemory} {ho : host.host},
       host.host_state * datatypes.store_record * datatypes.frame *
       list datatypes.administrative_instruction ->
       host.host_state * datatypes.store_record * datatypes.frame *
       list datatypes.administrative_instruction -> Prop

Arguments deterministic_outcome {hfc memory ho} c D
still_reaches_stuck_is_target
     : forall
         c
          D : host.host_state * datatypes.store_record * datatypes.frame *
              list datatypes.administrative_instruction,
       (forall
