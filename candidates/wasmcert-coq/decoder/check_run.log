reduce_det_fragment =
fun (hfc : datatypes.host_function_class) (memory : memory.BlockUpdateMemory)
  (ho : host.host) =>
forall (hs : host.host_state) (s : datatypes.store_record)
  (f : datatypes.frame) (es : list datatypes.administrative_instruction)
  (hs1 : host.host_state) (s1 : datatypes.store_record)
  (f1 : datatypes.frame) (es1 : list datatypes.administrative_instruction)
  (hs2 : host.host_state) (s2 : datatypes.store_record)
  (f2 : datatypes.frame) (es2 : list datatypes.administrative_instruction),
is_true (cfg_ok s es) ->
opsem.reduce hs s f es hs1 s1 f1 es1 ->
opsem.reduce hs s f es hs2 s2 f2 es2 ->
(hs1, s1, f1, es1) = (hs2, s2, f2, es2)
     : forall {hfc : datatypes.host_function_class}
         {memory : memory.BlockUpdateMemory},
       host.host -> Prop

