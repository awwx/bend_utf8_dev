pend =
fun st : Utf8Ref.State => match st with
                          | nil => 0
                          | (_ :: _)%list => 2
                          end
     : Utf8Ref.State -> nat

Arguments pend st
step_out_bound
     : forall (st : Utf8Ref.State) (b : Byte.byte),
       length (utf16le (snd (Utf8Ref.step st b))) +
       pend (fst (Utf8Ref.step st b)) <= 2 + pend st
decode_out_bound
     : forall (st : Utf8Ref.State) (bs : list Byte.byte),
       let
       '(st', t) := Utf8Ref.ref_decode_buffer st bs in
        length (utf16le t) + pend st' <= 2 * length bs + pend st
decode_out_area
     : forall (st : Utf8Ref.State) (bs : list Byte.byte),
       BinNat.N.le
         (BinNat.N.of_nat
            (length (utf16le (snd (Utf8Ref.ref_decode_buffer st bs)))))
         (out_area (length bs))
ref_done_out_bound
     : forall st : Utf8Ref.State,
       BinNat.N.le (BinNat.N.of_nat (length (utf16le (Utf8Ref.ref_done st))))
         (out_area 0)
