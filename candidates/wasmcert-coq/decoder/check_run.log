where
?hfc : [ |- datatypes.host_function_class]
?memory : [ |- memory.BlockUpdateMemory]
?ho : [ |- host.host]
cfg_ok =
fun (hfc : datatypes.host_function_class) (memory : memory.BlockUpdateMemory)
  (s : datatypes.store_record)
  (es : list datatypes.administrative_instruction) =>
(funcs_ok s && es_ok es)%bool
     : forall {hfc : datatypes.host_function_class}
         {memory : memory.BlockUpdateMemory},
       datatypes.store_record ->
       list datatypes.administrative_instruction -> bool

Arguments cfg_ok {hfc memory} s es%_list_scope%_seq_scope
funcs_ok =
fun (hfc : datatypes.host_function_class) (memory : memory.BlockUpdateMemory)
  (s : datatypes.store_record) =>
List.forallb func_ok (datatypes.s_funcs s)
     : forall {hfc : datatypes.host_function_class}
         {memory : memory.BlockUpdateMemory},
       datatypes.store_record -> bool

Arguments funcs_ok {hfc memory} s
func_ok =
fun (hfc : datatypes.host_function_class) (cl : datatypes.funcinst) =>
match cl with
| datatypes.FC_func_native _ _ mf =>
    List.forallb bi_ok (datatypes.modfunc_body mf)
| datatypes.FC_func_host _ _ => false
end
     : forall {hfc : datatypes.host_function_class},
       datatypes.funcinst -> bool

Arguments func_ok {hfc} cl
es_ok =
fun es : list datatypes.administrative_instruction => List.forallb ai_ok es
     : list datatypes.administrative_instruction -> bool

Arguments es_ok es%_list_scope%_seq_scope
ai_ok =
fix ai_ok (e : datatypes.administrative_instruction) : bool :=
  match e with
  | datatypes.AI_basic b => bi_ok b
  | datatypes.AI_trap | datatypes.AI_return_invoke _ => false
  | datatypes.AI_label _ es LI =>
      (List.forallb ai_ok es && List.forallb ai_ok LI)%bool
  | datatypes.AI_frame _ _ es => List.forallb ai_ok es
  | _ => true
  end
     : datatypes.administrative_instruction -> bool

Arguments ai_ok e
bi_ok =
fix bi_ok (b : datatypes.basic_instruction) : bool :=
  match b with
  | datatypes.BI_cvtop t2 _ t1 _ => (int_type t1 && int_type t2)%bool
  | datatypes.BI_unop t _ | datatypes.BI_binop t _ |
    datatypes.BI_testop t _ | datatypes.BI_relop t _ |
    datatypes.BI_load t _ _ | datatypes.BI_store t _ _ => 
      int_type t
  | datatypes.BI_block _ bs | datatypes.BI_loop _ bs => List.forallb bi_ok bs
  | datatypes.BI_if _ bs1 bs2 =>
      (List.forallb bi_ok bs1 && List.forallb bi_ok bs2)%bool
  | datatypes.BI_const_num _ | datatypes.BI_const_vec _ |
    datatypes.BI_ref_null _ | datatypes.BI_drop | 
    datatypes.BI_select _ | datatypes.BI_local_get _ |
    datatypes.BI_local_set _ | datatypes.BI_local_tee _ |
    datatypes.BI_global_get _ | datatypes.BI_global_set _ |
    datatypes.BI_memory_size | datatypes.BI_nop | 
    datatypes.BI_unreachable | datatypes.BI_br _ | 
    datatypes.BI_br_if _ | datatypes.BI_br_table _ _ | 
    datatypes.BI_return | datatypes.BI_call _ => true
  | _ => false
  end
     : datatypes.basic_instruction -> bool

Arguments bi_ok b
int_type =
fun t : datatypes.number_type =>
match t with
| datatypes.T_i32 | datatypes.T_i64 => true
| _ => false
end
     : datatypes.number_type -> bool

Arguments int_type t
decoder_call_outcome
     : forall (hs : host.host_state) (s : datatypes.store_record)
         (f : datatypes.frame) (a : datatypes.funcaddr)
         (args : list datatypes.value) (s' : datatypes.store_record)
         (res : list datatypes.value),
       datatypes.s_funcs s = datatypes.s_funcs Instance.s0 ->
       opsem.reduce_trans
         (hs, s, f,
          seq.cat (operations.v_to_e_list args)
            (datatypes.AI_invoke a :: nil))
         (hs, s', f, operations.v_to_e_list res) ->
       deterministic_outcome
         (hs, s, f,
          seq.cat (operations.v_to_e_list args)
            (datatypes.AI_invoke a :: nil))
         (hs, s', f, operations.v_to_e_list res)
