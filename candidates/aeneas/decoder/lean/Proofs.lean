/-
Proofs.lean -- proof of `Boundary.Verified` and `Boundary.VerifiedForWrapper`
with `Utf8Pure.RefDecoder` (shared pure layer, lean/pure/) as the witness.

How the files fit together:
  Decoder/Types.lean, Decoder/Funs.lean  generated by Charon + Aeneas from src/lib.rs
                                         (never edited; check.sh regenerates and compares)
  Boundary.lean                          the reviewed statements (hash-pinned in check.sh)
  pure/Utf8*.lean                        spec, RefDecoder, RefDecoder_correct, byte table,
                                         step facts (Utf8StepFacts: decodeBuffer_snoc, step_text_length)
  Proofs.lean (this file)                the refinement proof

Method: one spec lemma per Rust function, in the `f args ⦃ r => P r ⦄` form and tagged
`@[step]`, so that `step*` (Aeneas's symbolic execution) proves each caller by
chaining the callees' specs; what is left after `step*` is plain list/arithmetic
reasoning.  Each spec says the Rust function computes its Utf8Ref counterpart:
  §2 byte classes   is_cont .. vs4         r = isCont (byte b), isVS [..], isVSP [..]
  §3 code points    cp2/cp3/cp4            codePoint c = cpOf [..]
  §4 one step       emit/hold/step_fresh/bad_pending/step   OutRel o (Utf8Pure.step s b)
  §5 output         write_out              WritesText ... (t ++ outText o)
  §6 loop           loop_spec (loop.spec_decr_nat with LoopInv), decode_buffer_loop_spec
  §7 entry points   pack_spec, unpack_spec, decode_buffer_spec, decode_done_spec, start_rel (StRel)
  §8 top level      realizesWith, realizes, verified : Boundary.Verified
  §9 wrapper        countsBounded, wrapperCallsCovered, wrapperLayoutFits,
                    verified_for_wrapper : Boundary.VerifiedForWrapper (generic in D, R)
Relations: PendRel (Rust Pend record ~ pending-byte list), OutRel (Rust Out ~ reference
step result), StRel (packed u32 state ~ reference state), LoopInv.
Exports used elsewhere: verified, verified_for_wrapper, realizes (check.sh step 6).
-/
import Boundary
import Utf8StepFacts
open Aeneas Aeneas.Std Result Boundary Utf8Pure

namespace DecoderProofs

/-! ## 1. Rust values as spec values -/

@[simp] theorem byte_toNat (x : U8) : (byte x).toNat = x.val := by
  have := x.hBounds
  simp [byte]

@[simp] theorem codePoint_toNat (x : U32) : (codePoint x).toNat = x.val := by
  have := x.hBounds
  simp [codePoint]

@[simp] theorem byte_le (x : U8) (c : UInt8) : (c ≤ byte x) ↔ c.toNat ≤ x.val := by
  rw [UInt8.le_iff_toNat_le, byte_toNat]
@[simp] theorem le_byte (x : U8) (c : UInt8) : (byte x ≤ c) ↔ x.val ≤ c.toNat := by
  rw [UInt8.le_iff_toNat_le, byte_toNat]
@[simp] theorem byte_eq (x : U8) (c : UInt8) : (byte x = c) ↔ x.val = c.toNat := by
  rw [← UInt8.toNat_inj, byte_toNat]

theorem codePoint_eq_of (c : U32) (x : UInt32) (h : c.val = x.toNat) : codePoint c = x := by
  rw [← UInt32.toNat_inj, codePoint_toNat, h]

@[simp] theorem codePoint_cast (b : U8) : codePoint (UScalar.cast .U32 b) = cpOf [byte b] := by
  apply codePoint_eq_of
  rw [cpOf_one, byte_toNat]
  scalar_tac

@[simp] theorem codePoint_replacement : codePoint decoder.REPLACEMENT = replacement_char := by
  unfold decoder.REPLACEMENT; rfl

@[simp] theorem byte_zero : byte 0#u8 = 0 := rfl

/-- How a Rust `a && b` in tail position comes out of Aeneas, and the `if`
with `ok` in both branches: rewritten so that `simp` compares the Rust Bool
with the Utf8Ref Bool directly. -/
theorem ite_ok {α} (c : Prop) [Decidable c] (x y : α) :
    (if c then ok x else ok y : Result α) = ok (if c then x else y) := by
  by_cases c <;> simp [*]

/-- From the `⦃ ⦄` spec form to "returns `ok`", the form `Boundary` uses. -/
theorem spec_ok {α} {m : Result α} {P : α → Prop} (h : m ⦃ r => P r ⦄) : ∃ r, m = ok r ∧ P r := by
  generalize m = r at h ⊢
  cases r with
  | ret v => exact ⟨v, rfl, by simpa using h⟩
  | vis e k => simp [WP.spec_vis] at h
  | div => simp at h

/-! ## 2. Byte classes: each Rust predicate returns the Utf8Ref Bool -/

@[step] theorem is_cont_spec (b : U8) : decoder.is_cont b ⦃ r => r = isCont (byte b) ⦄ := by
  simp [decoder.is_cont, isCont, ite_ok]
@[step] theorem is_lead1_spec (b : U8) : decoder.is_lead1 b ⦃ r => r = isLead1 (byte b) ⦄ := by
  simp [decoder.is_lead1, isLead1]
@[step] theorem is_lead2_spec (b : U8) : decoder.is_lead2 b ⦃ r => r = isLead2 (byte b) ⦄ := by
  simp [decoder.is_lead2, isLead2, ite_ok]
@[step] theorem is_lead3_spec (b : U8) : decoder.is_lead3 b ⦃ r => r = isLead3 (byte b) ⦄ := by
  simp [decoder.is_lead3, isLead3, ite_ok]
@[step] theorem is_lead4_spec (b : U8) : decoder.is_lead4 b ⦃ r => r = isLead4 (byte b) ⦄ := by
  simp [decoder.is_lead4, isLead4, ite_ok]
@[step] theorem second_ok_spec (b1 b2 : U8) :
    decoder.second_ok b1 b2 ⦃ r => r = secondOk (byte b1) (byte b2) ⦄ := by
  simp [decoder.second_ok, secondOk, UScalar.eq_equiv, ite_ok]

@[step] theorem is_lead_multi_spec (b : U8) :
    decoder.is_lead_multi b ⦃ r => r = (isLead2 (byte b) || isLead3 (byte b) || isLead4 (byte b)) ⦄ := by
  unfold decoder.is_lead_multi; step*
@[step] theorem vs2_spec (b0 b1 : U8) : decoder.vs2 b0 b1 ⦃ r => r = isVS [byte b0, byte b1] ⦄ := by
  unfold decoder.vs2; step* <;> simp_all [isVS]
@[step] theorem vsp2_spec (b0 b1 : U8) : decoder.vsp2 b0 b1 ⦃ r => r = isVSP [byte b0, byte b1] ⦄ := by
  unfold decoder.vsp2; step* <;> simp_all [isVSP]
@[step] theorem vs3_spec (b0 b1 b2 : U8) :
    decoder.vs3 b0 b1 b2 ⦃ r => r = isVS [byte b0, byte b1, byte b2] ⦄ := by
  unfold decoder.vs3; step* <;> simp_all [isVS]
@[step] theorem vsp3_spec (b0 b1 b2 : U8) :
    decoder.vsp3 b0 b1 b2 ⦃ r => r = isVSP [byte b0, byte b1, byte b2] ⦄ := by
  unfold decoder.vsp3; step* <;> simp_all [isVSP]
@[step] theorem vs4_spec (b0 b1 b2 b3 : U8) :
    decoder.vs4 b0 b1 b2 b3 ⦃ r => r = isVS [byte b0, byte b1, byte b2, byte b3] ⦄ := by
  unfold decoder.vs4; step* <;> simp_all [isVS]

/-! ## 3. Code points: cp2/cp3/cp4 compute `cpOf` (its `%`/`*` form, `cpOf_two` ...) -/

@[step] theorem cp2_spec (b0 b1 : U8) :
    decoder.cp2 b0 b1 ⦃ c => codePoint c = cpOf [byte b0, byte b1] ⦄ := by
  unfold decoder.cp2; step*
  apply codePoint_eq_of; rw [cpOf_two]; simp only [byte_toNat]; scalar_tac
@[step] theorem cp3_spec (b0 b1 b2 : U8) :
    decoder.cp3 b0 b1 b2 ⦃ c => codePoint c = cpOf [byte b0, byte b1, byte b2] ⦄ := by
  unfold decoder.cp3; step*
  apply codePoint_eq_of; rw [cpOf_three]; simp only [byte_toNat]; scalar_tac
@[step] theorem cp4_spec (b0 b1 b2 b3 : U8) :
    decoder.cp4 b0 b1 b2 b3 ⦃ c => codePoint c = cpOf [byte b0, byte b1, byte b2, byte b3] ⦄ := by
  unfold decoder.cp4; step*
  apply codePoint_eq_of; rw [cpOf_four]; simp only [byte_toNat]; scalar_tac

/-! ## 4. One step: `step` refines `Utf8Pure.step` -/

/-- The Rust pending-bytes record holds the list `s` (its first `n` bytes). -/
def PendRel (p : decoder.Pend) (s : List UInt8) : Prop :=
  p.n.val ≤ 3 ∧ s = [byte p.b0, byte p.b1, byte p.b2].take p.n.val

/-- The code points a Rust `Out` emits. -/
def outText (o : decoder.Out) : Text := [codePoint o.c0, codePoint o.c1].take o.n.val

/-- A Rust `Out` is the reference result `r` (new pending bytes, emitted text). -/
def OutRel (o : decoder.Out) (r : State × Text) : Prop :=
  PendRel o.p r.1 ∧ o.n.val ≤ 2 ∧ outText o = r.2

@[step] theorem emit_spec (c : U32) :
    decoder.emit c ⦃ o => o = { p := decoder.EMPTY, n := 1#u8, c0 := c, c1 := 0#u32 } ⦄ := by
  simp [decoder.emit]

@[step] theorem hold_spec (p : decoder.Pend) :
    decoder.hold p ⦃ o => o = { p, n := 0#u8, c0 := 0#u32, c1 := 0#u32 } ⦄ := by
  simp [decoder.hold]

@[step] theorem step_fresh_spec (b : U8) :
    decoder.step_fresh b ⦃ o => OutRel o (stepFresh (byte b)) ∧ o.n.val ≤ 1 ⦄ := by
  unfold decoder.step_fresh
  step* <;> simp_all [stepFresh, isVS, isVSP, OutRel, PendRel, outText, decoder.EMPTY]

@[step] theorem bad_pending_spec (b : U8) :
    decoder.bad_pending b ⦃ o =>
      OutRel o ((stepFresh (byte b)).1, replacement_char :: (stepFresh (byte b)).2) ⦄ := by
  unfold decoder.bad_pending
  step*
  obtain ⟨hp, _, ht⟩ := f_post
  refine ⟨hp, by simp; omega, ?_⟩
  rw [← ht]
  rcases (by omega : f.n.val = 0 ∨ f.n.val = 1) with h | h <;> simp [outText, i_post, h]

@[step] theorem step_spec (p : decoder.Pend) (s : State) (hs : PendRel p s) (b : U8) :
    decoder.step p b ⦃ o => OutRel o (Utf8Pure.step s (byte b)) ⦄ := by
  obtain ⟨hn, rfl⟩ := hs
  have : p.n.val = 0 ∨ p.n.val = 1 ∨ p.n.val = 2 ∨ p.n.val = 3 := by omega
  unfold decoder.step
  rcases this with h | h | h | h <;> simp only [h, List.take_succ_cons, List.take_zero] <;> step*
  all_goals subst_vars
  -- emit / hold: both sides compute; step_fresh / bad_pending: the reference takes the same branch
  all_goals first
    | (simp [Utf8Pure.step, OutRel, PendRel, outText, decoder.EMPTY, *]; done)
    | (rw [step_nil]; exact o_post)
    | (rw [step_bad_pending _ _ (by simp) (by simpa using ‹¬ isVSP _ = true›)]; exact o_post)

/-! ## 5. Writing output -/

theorem writes_nil (out : Slice U32) : WritesText out out 0#usize [] := by
  simp [WritesText]

/-- Appending one code point `c` at index `k` to the text written so far. -/
theorem writes_one (out0 out1 : Slice U32) (k : Usize) (t : Text) (h : WritesText out0 out1 k t)
    (hk : k.val < out1.length) (c : U32) (k' : Usize) (hk' : k'.val = k.val + 1) :
    WritesText out0 (out1.set k c) k' (t ++ [codePoint c]) := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  have hl : out1.val.length = out1.length := rfl
  refine ⟨by simp [hk', h1], ?_, ?_, ?_⟩
  · simp [Slice.length, Slice.set_val_eq] at *; omega
  · rw [Slice.set_val_eq, List.set_eq_take_append_cons_drop, ite_eq_left (by omega)]
    rw [List.length_append, List.length_singleton, ← h1, List.take_append]
    have hA : (out1.val.take k.val).length = k.val := by simp; omega
    rw [hA, List.take_of_length_le (by omega), Nat.add_sub_cancel_left]
    simp [h1, h3]
  · rw [Slice.set_val_eq, List.length_append, ← h1, List.length_singleton, List.drop_set_of_lt (by omega)]
    have := congrArg (List.drop 1) h4
    simpa [List.drop_drop, h1, Nat.add_comm] using this

@[step] theorem write_out_spec (out0 out : Slice U32) (k : Usize) (t : Text) (o : decoder.Out)
    (hw : WritesText out0 out k t) (hn : o.n.val ≤ 2) (hfit : k.val + o.n.val ≤ out.length) :
    decoder.write_out out k o ⦃ k' out' => WritesText out0 out' k' (t ++ outText o) ⦄ := by
  have hl := hw.2.1
  unfold decoder.write_out
  split
  · next h =>
    have : o.n.val = 0 := by rw [h]; rfl
    simpa [outText, this] using hw
  · next h =>
    have : o.n.val = 1 := by rw [h]; rfl
    step*
    subst_vars
    simpa [outText, this] using writes_one _ _ _ _ hw (by omega) o.c0 _ k1_post
  · next h0 h1 =>
    have : o.n.val = 2 := by
      have : o.n.val ≠ 0 := fun e => h0 (UScalar.val_eq_imp _ _ (by rw [e]; rfl))
      have : o.n.val ≠ 1 := fun e => h1 (UScalar.val_eq_imp _ _ (by rw [e]; rfl))
      omega
    step*
    subst_vars
    have w1 := writes_one _ _ _ _ hw (by omega) o.c0 i i_post
    have w2 := writes_one _ _ _ _ w1 (by simp [Slice.length, Slice.set_val_eq] at *; omega) o.c1 k1 (by omega)
    simpa [outText, this] using w2

/-! ## 6. The decode_buffer loop -/

theorem bytes_take_succ (input : Slice U8) (i : Nat) (h : i < input.length) :
    (bytes input).take (i + 1) = (bytes input).take i ++ [byte (input.val[i]'h)] := by
  have h' : i < (bytes input).length := by simp [bytes, Slice.length] at *; exact h
  rw [List.take_add_one, List.getElem?_eq_getElem h']
  simp [bytes]

/-- Loop invariant: after `i` bytes, the Rust state holds the reference state
and `out` holds the reference text so far. -/
def LoopInv (input : Slice U8) (out0 : Slice U32) (s0 : State)
    (x : Slice U32 × decoder.Pend × Usize × Usize) : Prop :=
  x.2.2.1.val ≤ input.length ∧ x.2.2.2.val ≤ 2 * x.2.2.1.val ∧
  PendRel x.2.1 (decodeBuffer s0 ((bytes input).take x.2.2.1.val)).1 ∧
  WritesText out0 x.1 x.2.2.2 (decodeBuffer s0 ((bytes input).take x.2.2.1.val)).2

theorem loop_spec (input : Slice U8) (out0 : Slice U32) (s0 : State)
    (hout : 2 * input.length ≤ out0.length)
    (x : Slice U32 × decoder.Pend × Usize × Usize) (hx : LoopInv input out0 s0 x) :
    decoder.decode_buffer_loop input x.1 x.2.1 x.2.2.1 x.2.2.2 ⦃ r =>
      PendRel r.2.1 (decodeBuffer s0 (bytes input)).1 ∧
      WritesText out0 r.1 r.2.2 (decodeBuffer s0 (bytes input)).2 ⦄ := by
  unfold decoder.decode_buffer_loop
  apply loop.spec_decr_nat (measure := fun x => input.length - x.2.2.1.val) (inv := LoopInv input out0 s0)
  · rintro ⟨out1, p1, i1, k1⟩ ⟨hi, hk, hp, hw⟩
    simp only at hi hk hp hw
    have hl := hw.2.1
    unfold decoder.decode_buffer_loop.body
    step*
    · -- one more byte: the reference also takes one `step`
      obtain ⟨hop, hon, hot⟩ := o_post
      have hlt : i1.val < input.length := by scalar_tac
      have hnext : (bytes input).take i3.val = (bytes input).take i1.val ++ [byte i2] := by
        rw [i3_post, bytes_take_succ input _ hlt, i2_post]
      rw [hot] at k1_post
      have hk1 := k1_post.1
      have hk0 := hw.1
      have hlen := step_text_length (decodeBuffer s0 ((bytes input).take i1.val)).1 (byte i2)
      simp only [List.length_append] at hk1
      simp only [LoopInv, hnext, decodeBuffer_snoc]
      exact ⟨⟨by omega, by omega, hop, k1_post⟩, by omega⟩
    · -- all bytes consumed
      have htk : (bytes input).take i1.val = bytes input := by
        apply List.take_of_length_le; simp [bytes]; scalar_tac
      rw [htk] at hp hw
      exact ⟨hp, hw⟩
  · exact hx

/-- The loop as `decode_buffer` calls it: from the start of `input` and `out`. -/
@[step] theorem decode_buffer_loop_spec (input : Slice U8) (out : Slice U32) (p : decoder.Pend)
    (s : State) (hp : PendRel p s) (hout : 2 * input.length ≤ out.length) :
    decoder.decode_buffer_loop input out p 0#usize 0#usize ⦃ out' p' k =>
      PendRel p' (decodeBuffer s (bytes input)).1 ∧
      WritesText out out' k (decodeBuffer s (bytes input)).2 ⦄ := by
  have inv0 : LoopInv input out s (out, p, 0#usize, 0#usize) := by
    refine ⟨by simp, by simp, ?_, ?_⟩
    · simpa [decodeBuffer] using hp
    · simpa [decodeBuffer] using writes_nil out
  exact loop_spec input out s hout _ inv0

/-! ## 7. State packing and the entry points -/

/-- The Rust `u32` state `v` holds the reference state `s` (packed as in `pack`). -/
def StRel (s : State) (v : U32) : Prop :=
  Pending s ∧ ∃ p : decoder.Pend, PendRel p s ∧
    v.val = p.n.val + 256 * p.b0.val + 65536 * p.b1.val + 16777216 * p.b2.val

@[step] theorem pack_spec (q : decoder.Pend) : decoder.pack q ⦃ v =>
    v.val = q.n.val + 256 * q.b0.val + 65536 * q.b1.val + 16777216 * q.b2.val ⦄ := by
  unfold decoder.pack
  step*

/-- `unpack` gives back the pending bytes of a state related to `s`. -/
@[step] theorem unpack_spec (s : State) (v : U32) (hR : StRel s v) :
    decoder.unpack v ⦃ q => PendRel q s ⦄ := by
  obtain ⟨-, p, ⟨hn, rfl⟩, hv⟩ := hR
  unfold decoder.unpack
  step*
  -- the byte fields of the packed value, in Nat (one omega call each)
  have : p.n.val < 256 := by simpa using p.n.hBounds
  have : p.b0.val < 256 := by simpa using p.b0.hBounds
  have : p.b1.val < 256 := by simpa using p.b1.hBounds
  have : p.b2.val < 256 := by simpa using p.b2.hBounds
  have a0 : i.val = p.n.val := by rw [i_post, hv]; omega
  have a1 : i3.val = p.b0.val := by rw [i3_post, i2_post, hv]; omega
  have a2 : i6.val = p.b1.val := by rw [i6_post, i5_post, hv]; omega
  have a3 : i8.val = p.b2.val := by rw [i8_post, hv]; omega
  have e0 : i1.val = p.n.val := by rw [i1_post, UScalar.cast_val_eq, a0]; simp [*]
  have e1 : i4.val = p.b0.val := by rw [i4_post, UScalar.cast_val_eq, a1]; simp [*]
  have e2 : i7.val = p.b1.val := by rw [i7_post, UScalar.cast_val_eq, a2]; simp [*]
  have e3 : i9.val = p.b2.val := by rw [i9_post, UScalar.cast_val_eq, a3]; simp [*]
  simp [PendRel, byte, e0, e1, e2, e3, hn]

@[step] theorem decode_buffer_spec (s : State) (v : U32) (input : Slice U8) (out : Slice U32)
    (hR : StRel s v) (hout : 2 * input.length ≤ out.length) :
    decoder.decode_buffer v input out ⦃ (v', k) out' =>
      StRel (decodeBuffer s (bytes input)).1 v' ∧
      WritesText out out' k (decodeBuffer s (bytes input)).2 ⦄ := by
  unfold decoder.decode_buffer
  step*
  exact ⟨⟨decodeBuffer_pending s _ hR.1, _, out1_post, i_post⟩, out1_post1⟩

@[step] theorem decode_done_spec (s : State) (v : U32) (out : Slice U32) (hR : StRel s v)
    (hout : 1 ≤ out.length) :
    decoder.decode_done v out ⦃ k out' => WritesText out out' k (decodeDone s) ⦄ := by
  obtain ⟨_, p, ⟨hn, rfl⟩, hv⟩ := hR
  have := p.b0.hBounds; have := p.b1.hBounds; have := p.b2.hBounds
  have hmod : v.val % 256 = p.n.val := by scalar_tac
  unfold decoder.decode_done
  step*
  · have h0 : p.n.val = 0 := by scalar_tac
    simp [h0, decodeDone, writes_nil]
  · have h0 : p.n.val ≠ 0 := by scalar_tac
    have hne : [byte p.b0, byte p.b1, byte p.b2].take p.n.val ≠ [] := by simp [h0]
    rw [decodeDone_pending _ hne, out1_post]
    simpa using writes_one out out 0#usize [] (writes_nil out) (by scalar_tac) decoder.REPLACEMENT 1#usize rfl

theorem start_rel : StRel [] 0#u32 :=
  ⟨Or.inl rfl, { n := 0#u8, b0 := 0#u8, b1 := 0#u8, b2 := 0#u8 }, by simp [PendRel], by simp⟩

/-! ## 8. The top-level theorem -/

theorem realizesWith : RealizesWith RefDecoder StRel := by
  refine ⟨⟨0#u32, rfl, start_rel⟩, ?_, ?_⟩
  · intro s v input out hR hout
    obtain ⟨⟨⟨v', k⟩, out'⟩, h, hR', hw⟩ := spec_ok (decode_buffer_spec s v input out hR hout)
    exact ⟨v', k, out', h, hR', hw⟩
  · intro s v out hR hout
    obtain ⟨⟨k, out'⟩, h, hw⟩ := spec_ok (decode_done_spec s v out hR hout)
    exact ⟨k, out', h, hw⟩

theorem realizes : Realizes RefDecoder := ⟨StRel, realizesWith⟩

theorem verified : Verified := ⟨RefDecoder, RefDecoder_correct, realizes⟩

/-! ## 9. The wrapper statement (generic in D and R) -/

/-- The text written fits in the output slice. -/
theorem writes_le (out out' : Slice U32) (k : Usize) (t : Text) (h : WritesText out out' k t) :
    t.length ≤ out.length := by
  obtain ⟨_, hl, ht, _⟩ := h
  have := congrArg List.length ht
  simp only [List.length_map, List.length_take] at this
  simp only [Slice.length] at hl ⊢
  omega

/-- A model slice of `n ≤ Usize.max` zeros. -/
def zeros (n : Nat) (h : n ≤ Usize.max) : Slice U32 :=
  Slice.from (List.replicate n 0#u32) (by simpa using h)

theorem zeros_length (n : Nat) (h : n ≤ Usize.max) : (zeros n h).length = n := by
  simp [zeros]

/-- A model slice of `n ≤ Usize.max` zero bytes. -/
def bytesZeros (n : Nat) (h : n ≤ Usize.max) : Slice U8 :=
  Slice.from (List.replicate n 0#u8) (by simpa using h)

theorem bytesZeros_length (n : Nat) (h : n ≤ Usize.max) : (bytesZeros n h).length = n := by
  simp [bytesZeros]

theorem countsBounded (D : Decoder) (R : D.State → U32 → Prop) (h : RealizesWith D R) :
    CountsBounded D R := by
  obtain ⟨_, hbuf, hdone⟩ := h
  refine ⟨?_, ?_⟩
  · intro s v input out v' k out' hR hout hcall
    obtain ⟨v1, k1, o1, hc1, _, hw1⟩ := hbuf s v input out hR hout
    rw [hcall] at hc1
    simp at hc1
    have hk : k = k1 := hc1.2.1
    -- the same text, written into a slice of exactly 2 * |input| code points
    have hn : 2 * input.length ≤ Usize.max := le_trans hout out.property
    obtain ⟨_, _, _, _, _, hw2⟩ := hbuf s v input (zeros _ hn) hR (by rw [zeros_length])
    have := writes_le _ _ _ _ hw2
    rw [zeros_length] at this
    rw [hk, hw1.1]; exact this
  · intro s v out k out' hR hout hcall
    obtain ⟨k1, o1, hc1, hw1⟩ := hdone s v out hR hout
    rw [hcall] at hc1
    simp at hc1
    have hk : k = k1 := hc1.1
    have hn : 1 ≤ Usize.max := le_trans hout out.property
    obtain ⟨_, _, _, hw2⟩ := hdone s v (zeros 1 hn) hR (by rw [zeros_length])
    have := writes_le _ _ _ _ hw2
    rw [zeros_length] at this
    rw [hk, hw1.1]; exact this

theorem usize_max_ge : 4294967295 ≤ Usize.max := by
  rcases Usize.bounds_eq with h | h <;> rw [h] <;> simp [U32.max_eq, U64.max_eq]

theorem wrapperCallsCovered (D : Decoder) (R : D.State → U32 → Prop) (h : RealizesWith D R) :
    WrapperCallsCovered D R := by
  obtain ⟨hstart, hbuf, hdone⟩ := h
  have hmax := usize_max_ge
  refine ⟨hstart, ?_, ?_, ?_, ?_⟩
  · exact ⟨bytesZeros MaxChunkBytes (by unfold MaxChunkBytes; omega), bytesZeros_length _ _⟩
  · exact ⟨zeros OutCapacity (by unfold OutCapacity; omega), zeros_length _ _⟩
  · intro s v input out hR hin hout
    have h2 : 2 * input.length ≤ out.length := by
      rw [hout]; unfold MaxChunkBytes at hin; unfold OutCapacity; omega
    obtain ⟨v', k, o, hc, hR', _⟩ := hbuf s v input out hR h2
    exact ⟨h2, v', k, o, hc, hR'⟩
  · intro s v out hR hout
    have h1 : 1 ≤ out.length := by rw [hout]; unfold OutCapacity; omega
    obtain ⟨k, o, hc, _⟩ := hdone s v out hR h1
    exact ⟨h1, k, o, hc⟩

theorem wrapperLayoutFits : WrapperLayoutFits := by
  simp [WrapperLayoutFits, InputOffset, OutputOffset, StateOffset, ReservedBytes,
    MaxChunkBytes, OutCapacity]

theorem verified_for_wrapper : VerifiedForWrapper :=
  ⟨RefDecoder, RefDecoder_correct, StRel, realizesWith,
   countsBounded _ _ realizesWith, wrapperCallsCovered _ _ realizesWith, wrapperLayoutFits⟩

end DecoderProofs
